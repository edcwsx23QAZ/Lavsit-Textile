{
  "name": "lavsit-textile",
  "version": "0.1.0",
  "private": true,
  "description": "Lavsit Textile - парсер данных наличия и цен тканей от разных поставщиков",
  "scripts": {
    "dev": "next dev -p 4002",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start -p 4002",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:init": "tsx scripts/init-suppliers.ts",
    "db:fix-arteks": "tsx scripts/update-arteks-url.ts",
    "check:email-configs": "tsx scripts/check-email-configs.ts",
    "setup:email": "tsx scripts/setup-email-configs.ts",
    "auto-setup:email": "tsx scripts/auto-setup-email-configs.ts",
    "fix:ametist-filter": "tsx scripts/fix-ametist-subject-filter.ts",
    "test:ametist": "tsx scripts/test-ametist-parser.ts",
    "test:ametist-db": "tsx scripts/test-ametist-from-db.ts",
