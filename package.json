    "vercel:verify": "tsx scripts/verify-vercel-setup.ts",
    "vercel:setup-env": "tsx scripts/setup-vercel-env.ts",
    "vercel:status": "tsx scripts/check-deploy-status.ts",
    "db:test": "tsx scripts/test-db-connection.ts",
    "local-parser": "tsx scripts/local-parser-server.ts",
    "local-parser:dev": "tsx watch scripts/local-parser-server.ts",
